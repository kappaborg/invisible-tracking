# PartyKit host that powers the live audience wall.
# Leave unset for a pure single-device demo (the audience wall feature will be disabled).
#
# Get this value by deploying the PartyKit worker:
#   npx partykit deploy
# Then copy the printed hostname here, e.g.:
#   VITE_PARTYKIT_HOST=invisible-tracking-demo.your-username.partykit.dev
#
# On Vercel, set this in Project Settings → Environment Variables.
# VITE_PARTYKIT_HOST=
